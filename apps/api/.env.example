# Copy to .env and fill in.
# Local Postgres from the repo's docker-compose.yml:
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms

# A long random string (32+ characters). In production the server refuses to start with a short or placeholder one.
# One way to make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000

# Only needed when the web app is served from another domain (comma separated).
# CORS_ORIGINS=https://lms.example.com

# The website's server forwards its contact form here with this key (same value in the website's /admin → إشعارات الطلبات).
# APPLICATIONS_KEY=

# Behind a proxy (Railway, Render, a load balancer) set this so the sign-in limits see each visitor's real address.
# TRUST_PROXY=1

# First admin of a new deployment (no admin yet): created at startup, then never again.
# The password needs 12+ characters. Remove ADMIN_PASSWORD once you have signed in.
# ADMIN_EMAIL=you@academy.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Your name

# Email (password links, lesson reminders, invoices). Without SMTP_HOST nothing is sent;
# the admin's Settings page then says email is off. Any provider with SMTP works
# (Google Workspace, Zoho, Brevo, Resend, Amazon SES...).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Brightverse Academy <hello@brightverseacademy.com>
# The address people open, used in email links:
# APP_URL=https://app.brightverseacademy.com
